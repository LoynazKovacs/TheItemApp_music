{
  "version": 2,
  "appKey": "music",
  "appVersion": "1.0.1",
  "engineRequires": ">=1.0.0",
  "requiresCore": true,
  "collections": [
    {
      "collection": "groups",
      "file": "groups.json",
      "matchBy": "keyLower",
      "installMode": "shared",
      "exportFields": [
        "key",
        "name",
        "description",
        "permissions",
        "appId"
      ]
    },
    {
      "collection": "apps",
      "file": "apps.json",
      "matchBy": "key",
      "installMode": "shared",
      "filter": { "key": "music" }
    },
    {
      "collection": "items",
      "file": "items.json",
      "matchBy": "key",
      "installMode": "shared",
      "exportFields": [
        "key",
        "collection",
        "title",
        "titleSingular",
        "titlePlural",
        "description",
        "ai",
        "icon",
        "appId",
        "behavior",
        "schema",
        "ui",
        "api",
        "auth",
        "x-rls",
        "tier",
        "kind",
        "meta"
      ],
      "filter": { "appId": "<thisAppId>" }
    },
    {
      "collection": "music_tags",
      "file": "data/music_tags.json",
      "matchBy": "key",
      "installMode": "shared",
      "exportFields": ["key", "label", "category", "order", "enabled", "groupIds"]
    },
    {
      "collection": "prefabs",
      "file": "prefabs.json",
      "matchBy": "_id",
      "installMode": "shared",
      "exportFields": [
        "key",
        "title",
        "description",
        "icon",
        "type",
        "displayType",
        "reserved",
        "frontend",
        "defaultTile"
      ]
    },
    {
      "collection": "dashboards",
      "file": "dashboards.json",
      "matchBy": "_id",
      "installMode": "installConfig",
      "exportFields": [
        "appId",
        "name",
        "icon",
        "isHome",
        "statusId",
        "interactive",
        "groupIds",
        "gridsterConfigId",
        "tiles"
      ],
      "filter": { "appId": "<thisAppId>" }
    },
    {
      "collection": "windows",
      "file": "windows.json",
      "matchBy": "_id",
      "installMode": "installConfig",
      "exportFields": [
        "dashboardId",
        "title",
        "icon",
        "groupIds",
        "modelId",
        "prefabId",
        "prefabConfig",
        "sort"
      ]
    },
    {
      "collection": "item_tree_views",
      "file": "item_tree_views.json",
      "matchBy": "_id",
      "installMode": "installConfig",
      "exportFields": [
        "modelId",
        "name",
        "groupBy",
        "sortField",
        "sortDir",
        "sortFields",
        "leafLimit",
        "allowCreate",
        "rowDensity",
        "showAvatar",
        "avatarField",
        "avatarShape",
        "showIcon",
        "showBadge",
        "badgeField",
        "showTitle",
        "titleField",
        "titleWeight",
        "showSubtitle",
        "subtitleField",
        "subtitleLines",
        "showContent",
        "contentField",
        "contentLines",
        "showRightTop",
        "rightTopField",
        "rightTopFormat",
        "rightTopActionKeys",
        "rightTopShowLabel",
        "showRightMiddle",
        "rightMiddleField",
        "rightMiddleKind",
        "rightMiddleActionKeys",
        "rightMiddleShowLabel",
        "showRightBottom",
        "rightBottomField",
        "rightBottomKind",
        "rightBottomActionKeys",
        "rightBottomShowLabel",
        "clickActionKey",
        "isDefault",
        "pinned",
        "order",
        "appId"
      ],
      "filter": { "appId": "<thisAppId>" }
    },
    {
      "collection": "item_chart_views",
      "file": "item_chart_views.json",
      "matchBy": "_id",
      "installMode": "installConfig",
      "exportFields": [
        "modelId",
        "name",
        "data",
        "map",
        "option",
        "formatters",
        "builder",
        "isDefault",
        "pinned",
        "order",
        "appId"
      ],
      "filter": { "appId": "<thisAppId>" }
    },
    {
      "collection": "users",
      "file": "users.json",
      "matchBy": "_id",
      "installMode": "shared",
      "exportFields": ["username", "usernameLower", "isSystem", "groupIds", "isFunctional", "appId"]
    }
  ],
  "routes": [
    {
      "type": "federation-remote",
      "pathPrefix": "/mf/music",
      "upstream": "music:80"
    },
    {
      "type": "api-proxy",
      "pathPrefix": "/music-api",
      "upstream": "music-api:3009",
      "readTimeout": "10m"
    }
  ]
}
